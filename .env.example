# Copy this file to .env and fill in what you need. NEVER commit .env or share it.
# Paper trading needs nothing here. Telegram and the panel password are optional.
# Keep every comment on its own line: systemd's EnvironmentFile does not strip comments after a value.

# Telegram: create a bot with @BotFather, see README "Telegram setup"
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Web panel / phone app.
# PANEL_HOST=0.0.0.0 lets your phone on the same Wi-Fi reach it, and then PANEL_PASSWORD is required.
PANEL_HOST=127.0.0.1
PANEL_PORT=8787
PANEL_PASSWORD=
# Extra hostnames the panel answers to, comma-separated (e.g. a Tailscale name):
PANEL_ALLOWED_HOSTS=

# SHEET and LIVE modes: Jupiter API key (free at portal.jup.ag)
JUPITER_API_KEY=

# LIVE (real money) only. Leave empty unless you mean it. Use a NEW wallet holding only what you can lose.
# The wallet key (MEMEBOT_PRIVATE_KEY) is NEVER put in this file or any file: the bot refuses to start if it
# finds it here. Set it in the terminal that starts the bot (see README "Real money").
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Must be exactly: I UNDERSTAND THIS TRADES REAL MONEY
MEMEBOT_LIVE_ACK=
